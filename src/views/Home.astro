---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import { pages, pick, href, type Lang } from '../i18n/texts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages.home;
---

<Base lang={lang} path="" title={pick(p.metaTitle, lang)} description={pick(p.metaDescription, lang)}>
  <!-- Welcome: words first, then a picture with a slowly breathing halo -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-32 -left-24 h-80 w-80 rounded-full bg-peach blur-3xl"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 pt-14 pb-20 md:grid-cols-[1.1fr_1fr] md:pt-24">
      <div>
        <p class="text-base text-pink">{pick(p.eyebrow, lang)}</p>
        <h1 class="mt-4 text-[2.75rem] leading-[1.08] font-medium tracking-tight sm:text-6xl lg:text-7xl">
          {pick(p.title, lang)}
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-soft sm:text-xl">{pick(p.intro, lang)}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={href(lang, 'about')} class="rounded-full bg-orange px-8 py-4 text-center font-semibold text-white hover:opacity-90">
            {pick(p.primary, lang)}
          </a>
          <a href="#ways" class="rounded-full px-8 py-4 text-center font-semibold text-ink ring-1 ring-pink hover:bg-blush">
            {pick(p.secondary, lang)}
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md">
        <div class="breathe absolute inset-0 -m-6 rounded-[46%_54%_52%_48%/55%_45%_55%_45%] bg-blush"></div>
        <img
          src={p.heroImage}
          alt={pick(p.heroAlt, lang)}
          width="800"
          height="900"
          class="relative aspect-[8/9] w-full rounded-[46%_54%_52%_48%/55%_45%_55%_45%] object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Her journey comes first -->
  <section class="bg-blush/60">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <img
        src={p.storyImage}
        alt={pick(p.storyAlt, lang)}
        width="700"
        height="900"
        loading="lazy"
        class="mx-auto aspect-[7/9] w-full max-w-sm rounded-t-full rounded-b-3xl object-cover"
      />
      <div>
        <h2 class="text-lg text-soft">{pick(p.storyTitle, lang)}</h2>
        <p class="mt-4 font-serif text-3xl leading-snug italic sm:text-4xl">{pick(p.storyQuote, lang)}</p>
        <p class="mt-6 text-lg leading-relaxed text-soft">{pick(p.storyText, lang)}</p>
        <a href={href(lang, 'about')} class="mt-8 inline-block font-semibold text-orange underline decoration-pink decoration-2 underline-offset-8">
          {pick(p.storyLink, lang)}
        </a>
      </div>
    </div>
  </section>

  <!-- Then the ways to work with her -->
  <section id="ways" class="mx-auto max-w-4xl scroll-mt-8 px-5 py-20">
    <h2 class="text-3xl sm:text-4xl">{pick(p.waysTitle, lang)}</h2>
    <ul class="mt-10 divide-y divide-blush border-y border-blush">
      {p.ways.map((way) => (
        <li>
          <a href={href(lang, way.path)} class="flex items-center gap-5 py-7 sm:gap-8">
            <img src={way.image} alt="" width="400" height="400" loading="lazy" class="h-20 w-20 shrink-0 rounded-full object-cover sm:h-28 sm:w-28" />
            <span class="block">
              <span class="block font-serif text-2xl text-ink">{pick(way.title, lang)}</span>
              <span class="mt-1 block text-soft">{pick(way.text, lang)}</span>
              <span class="mt-3 block text-sm font-semibold text-orange">{pick(way.link, lang)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <CallToAction lang={lang} cta={p.cta} />
</Base>
