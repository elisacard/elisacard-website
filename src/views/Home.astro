---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import { pages, pick, href, type Lang } from '../i18n/texts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages.home;
---

<Base lang={lang} path="" title={pick(p.metaTitle, lang)} description={pick(p.metaDescription, lang)}>
  <!-- Welcome -->
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-12 sm:pt-28">
    <p class="text-sm font-semibold uppercase tracking-widest text-pink">{pick(p.eyebrow, lang)}</p>
    <h1 class="mt-4 text-4xl leading-tight sm:text-6xl">{pick(p.title, lang)}</h1>
    <span class="mt-6 block h-1 w-16 rounded-full bg-orange-light"></span>
    <p class="mt-6 text-lg leading-relaxed text-soft sm:text-xl">{pick(p.intro, lang)}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={href(lang, 'about')} class="rounded-full bg-orange px-7 py-3 text-center font-semibold text-white hover:opacity-90">
        {pick(p.primary, lang)}
      </a>
      <a href="#ways" class="rounded-full border border-pink px-7 py-3 text-center font-semibold text-ink hover:bg-blush">
        {pick(p.secondary, lang)}
      </a>
    </div>
  </section>

  <!-- Her journey first -->
  <section class="bg-peach">
    <div class="mx-auto max-w-3xl px-5 py-16">
      <h2 class="text-3xl">{pick(p.storyTitle, lang)}</h2>
      <p class="mt-4 text-lg leading-relaxed text-soft">{pick(p.storyText, lang)}</p>
      <a href={href(lang, 'about')} class="mt-6 inline-block font-semibold text-orange underline underline-offset-4">
        {pick(p.storyLink, lang)}
      </a>
    </div>
  </section>

  <!-- Then the ways to work with her -->
  <section id="ways" class="mx-auto max-w-5xl px-5 py-16">
    <h2 class="text-center text-3xl">{pick(p.waysTitle, lang)}</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {p.ways.map((way) => (
        <a href={href(lang, way.path)} class="group rounded-3xl border border-blush p-7 transition hover:border-pink hover:bg-blush/40">
          <span class="block h-2 w-2 rounded-full bg-pink"></span>
          <h3 class="mt-4 text-xl">{pick(way.title, lang)}</h3>
          <p class="mt-3 text-soft">{pick(way.text, lang)}</p>
          <span class="mt-5 inline-block text-sm font-semibold text-orange">{pick(p.more, lang)} →</span>
        </a>
      ))}
    </div>
  </section>

  <CallToAction lang={lang} cta={p.cta} />
</Base>
