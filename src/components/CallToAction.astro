---
// Soft pink invitation to get in touch, shown at the end of most pages.
import { pick, href, type Lang, type T } from '../i18n/texts';

interface Props {
  lang: Lang;
  cta: { title: T; text: T; button: T };
}
const { lang, cta } = Astro.props;
---

<section class="mx-auto max-w-3xl px-5 pt-12">
  <div class="rounded-3xl bg-blush px-6 py-10 text-center sm:px-12">
    <h2 class="text-2xl">{pick(cta.title, lang)}</h2>
    <p class="mt-3 text-soft">{pick(cta.text, lang)}</p>
    <a
      href={href(lang, 'contact')}
      class="mt-6 inline-block rounded-full bg-orange px-7 py-3 font-semibold text-white hover:opacity-90"
    >
      {pick(cta.button, lang)}
    </a>
  </div>
</section>
